---
export const prerender = false;

import Flash from '../../components/Flash.astro';
import Base from '../../layouts/Base.astro';
import { cityLabel } from '../../lib/cities';
import { getRepository } from '../../lib/repository';
import { siteConfig } from '../../config/site';

const token = Astro.params.token ?? '';
const repo = await getRepository(Astro.cookies.get('sb-access-token')?.value);
const view = token ? await repo.bookingByToken(token) : null;
if (!view) Astro.response.status = 404;
const open = view && (view.booking.status === 'requested' || view.booking.status === 'confirmed');
---

<Base title={`Booking request · ${siteConfig.brandName}`}>
  <main class="mx-auto max-w-2xl px-6 py-12">
    {
      !view ? (
        <h1 class="text-4xl font-bold">Request not found</h1>
      ) : (
        <article>
          <Flash />
          <p class="text-sm tracking-wide text-ink uppercase">{view.booking.status}</p>
          <h1 class="mt-2 text-4xl font-bold">Request with {view.artistName}</h1>
          <p class="mt-4 text-white/70">{cityLabel(view.citySlug)} · {view.booking.preferredDates}</p>
          {view.booking.proposedTime && <p class="mt-3">Proposed time: {view.booking.proposedTime}</p>}
          {view.booking.artistNote && <p class="mt-3 text-white/80">Note: {view.booking.artistNote}</p>}
          <p class="mt-6 text-white/70">This is a request, not a charge. Nothing is paid on this site.</p>
          {view.publicProfile && <a class="mt-6 inline-block text-ink underline" href={`/artists/${view.profileSlug}`}>Artist profile</a>}
          {
            open && (
              <form method="post" action="/api/bookings/cancel" class="mt-8">
                <input type="hidden" name="token" value={view.booking.manageToken} />
                <button class="rounded-full border border-white/20 px-4 py-2" type="submit">Cancel request</button>
              </form>
            )
          }
        </article>
      )
    }
  </main>
</Base>
