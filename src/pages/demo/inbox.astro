---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getRepository } from '../../lib/repository';
import { siteConfig } from '../../config/site';

if (!Astro.locals.demo) Astro.response.status = 404;
const emails = Astro.locals.demo
  ? await getRepository().then((repo) => repo.listEmails())
  : [];
---

<Base title={`Demo inbox · ${siteConfig.brandName}`}>
  <main class="mx-auto max-w-3xl px-6 py-12">
    {
      !Astro.locals.demo ? (
        <h1 class="text-4xl font-bold">Page not found</h1>
      ) : (
        <div>
          <h1 class="mb-4 text-4xl font-bold">Demo inbox</h1>
          <p class="mb-8 text-white/70">These messages were not sent to a real mailbox. They are the local stand-in for the email provider.</p>
          {
            emails.length === 0 ? (
              <p>No messages yet.</p>
            ) : (
              <ul class="space-y-4">
                {emails.map((email) => (
                  <li class="rounded-3xl border border-white/10 p-5">
                    <p class="text-sm text-white/50">To {email.to}</p>
                    <h2 class="mt-1 text-xl font-semibold">{email.subject}</h2>
                    <pre class="mt-3 whitespace-pre-wrap font-sans text-sm text-white/80">{email.text}</pre>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      )
    }
  </main>
</Base>
