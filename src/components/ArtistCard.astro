---
import type { PublicCard } from '../lib/types';

interface Props {
  card: PublicCard;
}

const { card } = Astro.props;
---

<a href={`/artists/${card.slug}`} class="block overflow-hidden rounded-3xl border border-white/10 bg-white/5 transition hover:border-ink">
  <div class="aspect-[4/5] bg-zinc-950">
    {
      card.photoUrl ? (
        <img src={card.photoUrl} alt={card.photoAlt ?? ''} class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full items-center justify-center text-sm text-white/40">No photo yet</div>
      )
    }
  </div>
  <div class="space-y-2 p-5">
    <div class="flex items-start justify-between gap-3">
      <h2 class="text-xl font-semibold">{card.displayName}</h2>
      {card.featured && <span class="text-xs font-semibold tracking-wide text-ink uppercase">Featured</span>}
    </div>
    <p class="text-sm text-white/70">{card.cityLabel}</p>
    <p class="text-sm text-white/85">{card.styles.map((style) => style.name).join(' · ')}</p>
  </div>
</a>
