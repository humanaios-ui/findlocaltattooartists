---
import type { PortfolioImageRecord } from '../lib/types';

interface Props {
  images: PortfolioImageRecord[];
}

const { images } = Astro.props;
---

{
  images.length === 0 ? (
    <p class="text-white/60">No published portfolio images yet.</p>
  ) : (
    <div class="grid gap-4 sm:grid-cols-2">
      {images.map((image) => (
        <button type="button" class="overflow-hidden rounded-3xl border border-white/10 text-left" data-lightbox data-src={image.url} data-alt={image.alt} data-tag={image.tag}>
          <img src={image.url} alt={image.alt} width="800" height="1000" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover" />
          <span class="block px-4 py-3 text-sm text-white/70">{image.tag === 'unspecified' ? 'Portfolio' : image.tag} · {image.alt}</span>
        </button>
      ))}
    </div>
  )
}

<dialog id="portfolio-lightbox" class="p-4" aria-label="Portfolio image">
  <img id="lightbox-image" alt="" class="max-h-[70vh] w-full rounded-2xl object-contain" />
  <p id="lightbox-caption" class="mt-3 text-sm text-white/80"></p>
  <button type="button" id="lightbox-close" class="mt-4 rounded-full bg-ink px-4 py-2">Close</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#portfolio-lightbox');
  const image = document.querySelector<HTMLImageElement>('#lightbox-image');
  const caption = document.querySelector('#lightbox-caption');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !image || !caption) return;
      image.src = button.dataset.src ?? '';
      image.alt = button.dataset.alt ?? '';
      caption.textContent = `${button.dataset.tag === 'unspecified' ? 'Portfolio' : button.dataset.tag} · ${button.dataset.alt ?? ''}`;
      dialog.showModal();
    });
  });
  document.querySelector('#lightbox-close')?.addEventListener('click', () => dialog?.close());
</script>
