# Copy to .env. Leave every secret empty to run the local demo.
# The anon key is public. The service role key is server-only:
# do not prefix it with PUBLIC_ and do not commit a real value.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required once Supabase is configured. Any long random string.
SESSION_SECRET=

# Optional override of the URL in src/config/site.ts.
PUBLIC_SITE_URL=

# Email. Leave both empty to log messages (demo inbox on localhost).
# Set one provider, and EMAIL_FROM to an address that provider has verified.
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=

# Host adapter for `npm run build`: node (default), cloudflare, or vercel.
# DEPLOY_TARGET=node

# Demo artists are on by default only under `npm run dev` when Supabase is unset.
# FLTA_DEMO=1 also enables them on another host (private preview only).
# FLTA_DEMO=0 refuses to run without Supabase.
